Options -Indexes

# ── Custom error pages ────────────────────────────────────────────────────────
ErrorDocument 404 /Shop/UX_SHOP/UX_Shop_New/404.php
ErrorDocument 500 /Shop/UX_SHOP/UX_Shop_New/500.php

# ── Block direct access to sensitive files ──────────────────────────────────
<FilesMatch "\.(env|log|sql|sh|bak|ini|lock|htpasswd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── Block access to hidden files/dirs (.env, .git, etc.) ─────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block hidden files and directories
    RewriteRule "(^|/)\." - [F,L]

    # Block direct access to logs directory
    RewriteRule ^logs(/|$) - [F,L]

    # Block direct access to migrations directory
    RewriteRule ^migrations(/|$) - [F,L]

    # Block direct access to private file storage (defense in depth)
    RewriteRule ^storage(/|$) - [F,L]

    # Block direct access to CLI scripts directory
    RewriteRule ^scripts(/|$) - [F,L]

    # Block access to includes directory (it has its own .htaccess too)
    RewriteRule ^includes(/|$) - [F,L]

    # Block access to diagnostic/debug scripts left in root
    RewriteRule ^(check-users|create-test-user|test-login|test-session|seed-bundles|test_cart_phase2|test-smtp|test-contact-db|diag-razorpay|encrypt-storage|audit-api-smoke)\.php$ - [F,L]
</IfModule>

# ── PHP settings ──────────────────────────────────────────────────────────────
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag display_startup_errors off
    php_flag log_errors on
</IfModule>
