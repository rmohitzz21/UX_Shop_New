# ── App ──────────────────────────────────────────────────────────────────────
APP_DEBUG=false
APP_URL=http://localhost/Shop/UX_SHOP/UX_Shop_New

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=uxmerchandise

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=img/products

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=hello@uxpacific.com

# ── SMTP (for welcome/order/reset emails) ─────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@uxpacific.com
SMTP_PASS=REPLACE_ME
SMTP_FROM=noreply@uxpacific.com
SMTP_FROM_NAME=UX Pacific Shop

# ── Razorpay (payment gateway) ────────────────────────────────────────────────
RAZORPAY_KEY_ID=REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ── Dev/seed tools (remove in production) ────────────────────────────────────
# SEED_KEY=change-me

# ── Test payment (dev/staging only — NEVER set true in production) ────────────
# ENABLE_TEST_PAYMENT=true
