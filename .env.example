# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/Shop/UX_SHOP/UX_Shop_New

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=uxmerchandise

# ── File uploads (public product images only) ─────────────────────────────────
UPLOAD_DIR=img/products

# ── Admin notifications (contact form, new orders) ───────────────────────────
ADMIN_EMAIL=hello@uxpacific.com
ADMIN_NOTIFICATION_EMAIL=hello@uxpacific.com

# ── Email / SMTP (password ONLY in .env — never commit real values) ─────────
SMTP_HOST=mail.uxpacific.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=support@uxpacific.com
SMTP_PASS=
SMTP_FROM_EMAIL=support@uxpacific.com
SMTP_FROM_NAME=UX Pacific
SUPPORT_EMAIL=support@uxpacific.com

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ── Digital storage (private files — never under web root) ───────────────────
DIGITAL_STORAGE_DRIVER=local
DIGITAL_STORAGE_LOCAL_DIR=

# AES-256-GCM at-rest encryption for locally-stored digital files (recommended).
# Generate a key: php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
# Existing plaintext files continue to work; new uploads are encrypted automatically.
# WARNING: Losing this key makes all encrypted files permanently unreadable. Back it up.
DIGITAL_STORAGE_ENCRYPT_KEY=
DIGITAL_STORAGE_REQUIRE_ENCRYPTION=true

# Signed download links for local storage (seconds). Link expires; user must re-open order.
DIGITAL_DOWNLOAD_ACCESS_TTL_SECONDS=600

DIGITAL_STORAGE_ENDPOINT=
DIGITAL_STORAGE_REGION=auto
DIGITAL_STORAGE_BUCKET=
DIGITAL_STORAGE_ACCESS_KEY=
DIGITAL_STORAGE_SECRET_KEY=
DIGITAL_STORAGE_PRESIGN_TTL_SECONDS=300

# ── Dev only (must be false/unset in production) ─────────────────────────────
ENABLE_TEST_PAYMENT=false
