# UX Pacific Shop — Local Environment Configuration
# DO NOT commit this file to version control

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Shop/UX_SHOP/UX_Shop_New

# Database
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=uxmerchandise

# Razorpay — replace with real test keys from razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME_SECRET
RAZORPAY_WEBHOOK_SECRET=
ENABLE_TEST_PAYMENT=true

# SMTP Configuration
SMTP_HOST=mail.uxpacific.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_ENCRYPTION=ssl
SMTP_USER=support@uxpacific.com
SMTP_PASS=UXPacific#2025
SMTP_FROM=support@uxpacific.com
SMTP_FROM_NAME=UX Pacific Shop

# Support / admin emails
SUPPORT_EMAIL=support@uxpacific.com
ADMIN_EMAIL=hello@uxpacific.com
ADMIN_NOTIFICATION_EMAIL=hello@uxpacific.com

# Digital storage
DIGITAL_STORAGE_DRIVER=local
DIGITAL_STORAGE_LOCAL_DIR=
DIGITAL_UPLOAD_MAX_BYTES=52428800
